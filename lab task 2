<!DOCTYPE html>
<html>

<head>
    <title>labtask2</title>
    <link rel="stylesheet" href="file.css">
</head>

<body>

    <form>

        <div>

            <label for="fullname">FullName:</label>
            <input type="text" name="Fullname" id="FullName" required>

        </div>

        <br><br>

        <label for="password">password:</label>
        <input type="password" name="password" id="password">

        <br><br>

        <label for="dob">DOB:</label>
        <input type="date" name="dob" id="dob">

        <br><br>

        <label for="photo">PICTURE:</label>
        <input type="file" name="photo" id="photo">

        <br><br>

        <label>Gender:</label>
        <input type="radio" name="gender" id="gender1" value="Female">Female
        <input type="radio" name="gender" id="gender2" value="Male">Male

        <br><br>

        <label for="religion">Relegion:</label>
        <input type="checkbox" name="r1" id="r1" value="Islam" checked>Islam
        <input type="checkbox" name="r2" id="r2" value="Hindu" checked>Hindu

        <br><br>

        <div>

            <label for="department">Department:</label>

            <select name="department" id="department">
                <option value="CSE" selected>CSE</option>
                <option value="EEE">EEE</option>
            </select>

        </div>

        <br>

        <div>

            <label for="address">Write down the address:</label>
            <textarea name="address" id="address" rows="15"></textarea>

        </div>

        <div>

            <input type="submit" value="Register">
            <input type="reset" value="Clear" disabled>

        </div>

    </form>

</body>
</html>
